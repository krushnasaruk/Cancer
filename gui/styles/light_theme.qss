/* =============================================================================
   Sesame AI Digital Twin — Pure Studio Light Mode
   Clean, Crisp, High-Contrast Light Theme
   ============================================================================= */

QMainWindow, QDialog, QWidget {
    background-color: #f1f5f9;
    color: #0f172a;
    font-family: "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 12px;
}

/* ================= Top Navigation Bar ================= */
QFrame#ControlBarFrame {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 6px 14px;
}

QLabel#AppTitle {
    color: #2563eb;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.5px;
}

QLabel#AppSubtitle {
    color: #64748b;
    font-size: 10px;
    font-weight: 500;
}

QMenuBar {
    background-color: #f1f5f9;
    color: #475569;
    border-bottom: 1px solid #cbd5e1;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: 600;
}

QMenuBar::item:selected {
    background-color: #e2e8f0;
    color: #2563eb;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item:selected {
    background-color: #eff6ff;
    color: #2563eb;
    border-radius: 4px;
}

QStatusBar {
    background-color: #ffffff;
    color: #64748b;
    border-top: 1px solid #cbd5e1;
    font-size: 11px;
    font-weight: 600;
}

/* ================= Buttons ================= */
QPushButton {
    background-color: #e2e8f0;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 700;
    font-size: 11px;
}

QPushButton:hover {
    background-color: #cbd5e1;
    border-color: #2563eb;
}

QPushButton:pressed {
    background-color: #94a3b8;
}

QPushButton#btn_start {
    background: #10b981;
    color: #ffffff;
    border: 1px solid #059669;
}
QPushButton#btn_start:hover {
    background: #059669;
}

QPushButton#btn_pause {
    background: #f59e0b;
    color: #ffffff;
    border: 1px solid #d97706;
}
QPushButton#btn_pause:hover {
    background: #d97706;
}

QPushButton#btn_reset {
    background: #3b82f6;
    color: #ffffff;
    border: 1px solid #2563eb;
}
QPushButton#btn_reset:hover {
    background: #2563eb;
}

QPushButton#btn_estop {
    background: #ef4444;
    color: #ffffff;
    border: 1px solid #dc2626;
    font-weight: 800;
}
QPushButton#btn_estop:hover {
    background: #dc2626;
}

/* ================= Form Controls ================= */
QComboBox {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 600;
}

QComboBox:hover {
    border-color: #2563eb;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    selection-background-color: #eff6ff;
    selection-color: #2563eb;
    border-radius: 6px;
    padding: 4px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #cbd5e1;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #2563eb;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #2563eb;
    width: 12px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 6px;
}

/* ================= Tab Widget & Sidebar ================= */
QTabWidget#SidebarTabs::pane {
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
    border-radius: 10px;
    padding: 6px;
}

QTabBar::tab {
    background-color: #e2e8f0;
    color: #475569;
    padding: 8px 14px;
    margin-right: 3px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 700;
    font-size: 11px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2563eb;
    border: 1px solid #cbd5e1;
    border-bottom: 2px solid #2563eb;
}

QTabBar::tab:hover:!selected {
    background-color: #cbd5e1;
    color: #0f172a;
}

/* Cards inside Sidebar */
QFrame.CardFrame, QGroupBox {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px;
}

/* ================= Tables ================= */
QTableWidget, QTableView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    gridline-color: #f1f5f9;
    border-radius: 6px;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #2563eb;
    font-weight: 700;
    font-size: 11px;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #cbd5e1;
}

QTableWidget::item:selected {
    background-color: #eff6ff;
    color: #2563eb;
}

/* ================= Scrollbars ================= */
QScrollBar:vertical {
    background: #f1f5f9;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #2563eb;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
